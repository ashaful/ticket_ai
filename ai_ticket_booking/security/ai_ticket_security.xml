<odoo>
    <record id="module_category_ai_ticket" model="ir.module.category">
        <field name="name">AI Ticket Booking</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_ai_ticket" model="res.groups.privilege">
        <field name="name">AI Ticket Booking</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="module_category_ai_ticket"/>
    </record>

    <record id="group_ai_ticket_user" model="res.groups">
        <field name="name">Ticket User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_ai_ticket"/>
    </record>

    <record id="group_ai_ticket_operator" model="res.groups">
        <field name="name">Ticket Operator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_ai_ticket"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_ticket_user'))]"/>
    </record>

    <record id="group_ai_ticket_manager" model="res.groups">
        <field name="name">Ticket Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_ai_ticket"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_ticket_operator'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Global multi-company fences -->
    <record id="rule_request_company" model="ir.rule">
        <field name="name">AI Ticket Request: company</field>
        <field name="model_id" ref="model_ai_ticket_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_traveler_company" model="ir.rule">
        <field name="name">AI Ticket Traveler: company</field>
        <field name="model_id" ref="model_ai_ticket_traveler"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_provider_company" model="ir.rule">
        <field name="name">AI Ticket Provider: company</field>
        <field name="model_id" ref="model_ai_ticket_provider"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_release_company" model="ir.rule">
        <field name="name">AI Ticket Release: company</field>
        <field name="model_id" ref="model_ai_ticket_release"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_execution_company" model="ir.rule">
        <field name="name">AI Ticket Execution: company</field>
        <field name="model_id" ref="model_ai_ticket_execution"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_action_company" model="ir.rule">
        <field name="name">AI Ticket Action: company</field>
        <field name="model_id" ref="model_ai_ticket_action"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_log_company" model="ir.rule">
        <field name="name">AI Ticket Log: company</field>
        <field name="model_id" ref="model_ai_ticket_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>


    <record id="rule_request_line_company" model="ir.rule">
        <field name="name">AI Ticket Request Line: company</field>
        <field name="model_id" ref="model_ai_ticket_request_line"/>
        <field name="domain_force">[('request_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_preference_line_company" model="ir.rule">
        <field name="name">AI Ticket Preference Line: company</field>
        <field name="model_id" ref="model_ai_ticket_preference_line"/>
        <field name="domain_force">[('request_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_request_traveler_company" model="ir.rule">
        <field name="name">AI Ticket Request Traveler: company</field>
        <field name="model_id" ref="model_ai_ticket_request_traveler"/>
        <field name="domain_force">[('request_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_webhook_event_company" model="ir.rule">
        <field name="name">AI Ticket Webhook Event: company</field>
        <field name="model_id" ref="model_ai_ticket_webhook_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_request_line_user_own" model="ir.rule">
        <field name="name">AI Ticket Request Line: own request</field>
        <field name="model_id" ref="model_ai_ticket_request_line"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_user'))]"/>
        <field name="domain_force">[('request_id.owner_user_id', '=', user.id)]</field>
    </record>
    <record id="rule_request_line_operator_all" model="ir.rule">
        <field name="name">AI Ticket Request Line: operator all</field>
        <field name="model_id" ref="model_ai_ticket_request_line"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_operator'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_preference_line_user_own" model="ir.rule">
        <field name="name">AI Ticket Preference Line: own request</field>
        <field name="model_id" ref="model_ai_ticket_preference_line"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_user'))]"/>
        <field name="domain_force">[('request_id.owner_user_id', '=', user.id)]</field>
    </record>
    <record id="rule_preference_line_operator_all" model="ir.rule">
        <field name="name">AI Ticket Preference Line: operator all</field>
        <field name="model_id" ref="model_ai_ticket_preference_line"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_operator'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_request_traveler_user_own" model="ir.rule">
        <field name="name">AI Ticket Request Traveler: own request</field>
        <field name="model_id" ref="model_ai_ticket_request_traveler"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_user'))]"/>
        <field name="domain_force">[('request_id.owner_user_id', '=', user.id)]</field>
    </record>
    <record id="rule_request_traveler_operator_all" model="ir.rule">
        <field name="name">AI Ticket Request Traveler: operator all</field>
        <field name="model_id" ref="model_ai_ticket_request_traveler"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_operator'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Regular users see only requests/travelers they own. Operators gain broader rules (rules are additive within group scope). -->
    <record id="rule_request_user_own" model="ir.rule">
        <field name="name">AI Ticket Request: own</field>
        <field name="model_id" ref="model_ai_ticket_request"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_user'))]"/>
        <field name="domain_force">[('owner_user_id', '=', user.id)]</field>
    </record>
    <record id="rule_request_operator_all" model="ir.rule">
        <field name="name">AI Ticket Request: operator all company</field>
        <field name="model_id" ref="model_ai_ticket_request"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_operator'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_traveler_user_own" model="ir.rule">
        <field name="name">AI Ticket Traveler: own</field>
        <field name="model_id" ref="model_ai_ticket_traveler"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_user'))]"/>
        <field name="domain_force">[('owner_user_id', '=', user.id)]</field>
    </record>
    <record id="rule_traveler_operator_all" model="ir.rule">
        <field name="name">AI Ticket Traveler: operator all company</field>
        <field name="model_id" ref="model_ai_ticket_traveler"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_operator'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_execution_user_own" model="ir.rule">
        <field name="name">AI Ticket Execution: own request</field>
        <field name="model_id" ref="model_ai_ticket_execution"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_user'))]"/>
        <field name="domain_force">[('request_id.owner_user_id', '=', user.id)]</field>
    </record>
    <record id="rule_execution_operator_all" model="ir.rule">
        <field name="name">AI Ticket Execution: operator all</field>
        <field name="model_id" ref="model_ai_ticket_execution"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_operator'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_action_user_own" model="ir.rule">
        <field name="name">AI Ticket Action: own request</field>
        <field name="model_id" ref="model_ai_ticket_action"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_user'))]"/>
        <field name="domain_force">[('request_id.owner_user_id', '=', user.id)]</field>
    </record>
    <record id="rule_action_operator_all" model="ir.rule">
        <field name="name">AI Ticket Action: operator all</field>
        <field name="model_id" ref="model_ai_ticket_action"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_operator'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_log_user_own" model="ir.rule">
        <field name="name">AI Ticket Log: own request</field>
        <field name="model_id" ref="model_ai_ticket_log"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_user'))]"/>
        <field name="domain_force">[('request_id.owner_user_id', '=', user.id)]</field>
    </record>
    <record id="rule_log_operator_all" model="ir.rule">
        <field name="name">AI Ticket Log: operator all</field>
        <field name="model_id" ref="model_ai_ticket_log"/>
        <field name="groups" eval="[(4, ref('group_ai_ticket_operator'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
