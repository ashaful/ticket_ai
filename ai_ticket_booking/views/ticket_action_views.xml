<odoo>
    <record id="view_ai_ticket_action_list" model="ir.ui.view">
        <field name="name">ai.ticket.action.list</field>
        <field name="model">ai.ticket.action</field>
        <field name="arch" type="xml">
            <list decoration-danger="priority == '2' and status in ('open','in_progress')" decoration-warning="status == 'open'">
                <field name="priority" widget="priority"/>
                <field name="request_id"/>
                <field name="action_type"/>
                <field name="status" widget="badge"/>
                <field name="expires_at"/>
                <field name="claimed_by_id" optional="show"/>
                <button name="action_take_control" type="object" string="Take Control" class="btn-primary" groups="ai_ticket_booking.group_ai_ticket_operator" invisible="status not in ('open','in_progress')"/>
                <button name="action_resume" type="object" string="Resume" groups="ai_ticket_booking.group_ai_ticket_operator" invisible="status not in ('open','in_progress')"/>
            </list>
        </field>
    </record>
    <record id="view_ai_ticket_action_form" model="ir.ui.view">
        <field name="name">ai.ticket.action.form</field>
        <field name="model">ai.ticket.action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_take_control" type="object" string="Take Control" class="btn-primary" groups="ai_ticket_booking.group_ai_ticket_operator" invisible="status not in ('open','in_progress')"/>
                    <button name="action_resume" type="object" string="Resume Automation" class="btn-primary" groups="ai_ticket_booking.group_ai_ticket_operator" invisible="status not in ('open','in_progress')"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="execution_id"/>
                            <field name="action_type"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="expires_at"/>
                            <field name="claimed_by_id"/>
                            <field name="claimed_at"/>
                            <field name="resolved_at"/>
                        </group>
                    </group>
                    <field name="instructions" readonly="True"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ai_ticket_human_actions" model="ir.actions.act_window">
        <field name="name">Human Action Queue</field>
        <field name="res_model">ai.ticket.action</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', 'in', ['open','in_progress'])]</field>
    </record>
</odoo>
