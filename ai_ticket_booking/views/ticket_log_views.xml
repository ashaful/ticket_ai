<odoo>
    <record id="view_ai_ticket_log_list" model="ir.ui.view">
        <field name="name">ai.ticket.log.list</field>
        <field name="model">ai.ticket.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="level == 'error'" decoration-warning="level == 'warning'">
                <field name="create_date"/>
                <field name="request_id"/>
                <field name="execution_id" optional="hide"/>
                <field name="level" widget="badge"/>
                <field name="event_code"/>
                <field name="message"/>
                <field name="duration_ms" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_ai_ticket_log_form" model="ir.ui.view">
        <field name="name">ai.ticket.log.form</field>
        <field name="model">ai.ticket.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="request_id"/>
                        <field name="execution_id"/>
                        <field name="level"/>
                        <field name="event_code"/>
                        <field name="duration_ms"/>
                    </group>
                    <field name="message"/>
                    <field name="payload_json" groups="ai_ticket_booking.group_ai_ticket_manager"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ai_ticket_logs" model="ir.actions.act_window">
        <field name="name">Execution Logs</field>
        <field name="res_model">ai.ticket.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
