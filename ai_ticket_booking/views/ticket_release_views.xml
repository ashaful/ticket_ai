<odoo>
    <record id="view_ai_ticket_release_list" model="ir.ui.view">
        <field name="name">ai.ticket.release.list</field>
        <field name="model">ai.ticket.release</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'live'" decoration-warning="status in ('estimated','changed')">
                <field name="provider_id"/>
                <field name="visit_date_from"/>
                <field name="visit_date_to" optional="hide"/>
                <field name="status" widget="badge"/>
                <field name="release_at"/>
                <field name="timezone"/>
                <field name="source_type" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_ai_ticket_release_form" model="ir.ui.view">
        <field name="name">ai.ticket.release.form</field>
        <field name="model">ai.ticket.release</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="True"/></h1></div>
                    <group>
                        <group>
                            <field name="provider_id"/>
                            <field name="visit_date_from"/>
                            <field name="visit_date_to"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="release_at"/>
                            <field name="timezone" readonly="True"/>
                            <field name="announced_at"/>
                            <field name="source_type"/>
                            <field name="source_reference"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ai_ticket_releases" model="ir.actions.act_window">
        <field name="name">Release Information</field>
        <field name="res_model">ai.ticket.release</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
