<odoo>
    <record id="view_ai_ticket_execution_list" model="ir.ui.view">
        <field name="name">ai.ticket.execution.list</field>
        <field name="model">ai.ticket.execution</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'failed'" decoration-success="status == 'completed'">
                <field name="request_id"/>
                <field name="status" widget="badge"/>
                <field name="worker_job_id" optional="show"/>
                <field name="started_at"/>
                <field name="finished_at"/>
                <field name="last_event_at" optional="show"/>
                <field name="error_code" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_ai_ticket_execution_form" model="ir.ui.view">
        <field name="name">ai.ticket.execution.form</field>
        <field name="model">ai.ticket.execution</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="execution_uuid"/>
                            <field name="worker_job_id"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="last_event_at"/>
                            <field name="error_code"/>
                        </group>
                    </group>
                    <field name="error_message" invisible="not error_message"/>
                    <field name="timing_json" readonly="True" groups="ai_ticket_booking.group_ai_ticket_operator"/>
                    <field name="response_json" readonly="True" groups="ai_ticket_booking.group_ai_ticket_manager"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ai_ticket_executions" model="ir.actions.act_window">
        <field name="name">Executions</field>
        <field name="res_model">ai.ticket.execution</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
