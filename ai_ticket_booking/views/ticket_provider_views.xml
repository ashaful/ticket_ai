<odoo>
    <record id="view_ai_ticket_provider_list" model="ir.ui.view">
        <field name="name">ai.ticket.provider.list</field>
        <field name="model">ai.ticket.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="timezone"/>
                <field name="release_mode"/>
                <field name="booking_supported"/>
                <field name="release_monitor_supported"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_ai_ticket_provider_form" model="ir.ui.view">
        <field name="name">ai.ticket.provider.form</field>
        <field name="model">ai.ticket.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="code"/>
                            <field name="worker_provider_key"/>
                            <field name="website_url" widget="url"/>
                            <field name="timezone"/>
                        </group>
                        <group>
                            <field name="release_mode"/>
                            <field name="default_currency_id"/>
                            <field name="requires_traveler_details"/>
                            <field name="requires_identity_document"/>
                            <field name="booking_supported"/>
                            <field name="release_monitor_supported"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Provider-specific operational notes. Do not store credentials here."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ai_ticket_providers" model="ir.actions.act_window">
        <field name="name">Ticket Providers</field>
        <field name="res_model">ai.ticket.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
