<odoo>
    <record id="view_ai_ticket_traveler_list" model="ir.ui.view">
        <field name="name">ai.ticket.traveler.list</field>
        <field name="model">ai.ticket.traveler</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="birth_date" optional="show"/>
                <field name="nationality_id" optional="show"/>
                <field name="email" optional="hide"/>
                <field name="owner_user_id" optional="hide"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_ai_ticket_traveler_form" model="ir.ui.view">
        <field name="name">ai.ticket.traveler.form</field>
        <field name="model">ai.ticket.traveler</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="True"/></h1></div>
                    <group>
                        <group>
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="birth_date"/>
                            <field name="nationality_id"/>
                        </group>
                        <group>
                            <field name="owner_user_id"/>
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Sensitive Identity Data" groups="ai_ticket_booking.group_ai_ticket_manager">
                        <field name="document_type"/>
                        <field name="document_number" password="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ai_ticket_travelers" model="ir.actions.act_window">
        <field name="name">Travelers</field>
        <field name="res_model">ai.ticket.traveler</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
